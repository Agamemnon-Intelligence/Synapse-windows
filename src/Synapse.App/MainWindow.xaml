<Window x:Class="Synapse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Synapse" Width="1280" Height="840" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0A0B0C" Icon="pack://application:,,,/synapse.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="BrowserColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="Ui" Grid.Column="0"/>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#16171A"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Visibility="Collapsed"
                      DragCompleted="Splitter_DragCompleted"/>

        <DockPanel x:Name="BrowserPane" Grid.Column="2" Background="{DynamicResource PaneBrush}" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="8,8,8,6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="Back" Click="Back_Click"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="Forward" Click="Forward_Click"/>
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE8BB;" ToolTip="Close browser (Ctrl+Shift+B)" Click="CloseBrowser_Click"/>
                    <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE712;" ToolTip="More" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in Default Browser" Click="OpenExternal_Click"/>
                                <MenuItem Header="Copy Address" Click="CopyAddress_Click"/>
                                <Separator/>
                                <MenuItem Header="Developer Tools" Click="DevTools_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBox x:Name="Address" Style="{StaticResource AddressBox}" Height="28" Margin="6,0,4,0"
                             KeyDown="Address_KeyDown" GotKeyboardFocus="Address_GotKeyboardFocus"/>
                </DockPanel>
            </Border>
            <Border x:Name="AgentBanner" DockPanel.Dock="Top" Margin="8,0,8,6" Padding="12,6" CornerRadius="10" Background="#263B82F5" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Take Over" Click="TakeOver_Click"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AgentText" Foreground="{DynamicResource SubtleBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Grid>
                <wv2:WebView2 x:Name="Web"/>
                <StackPanel x:Name="WebPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Turn on Browser in a chat and the model can browse here." Foreground="{DynamicResource SubtleBrush}" Margin="0,10,0,0" FontSize="13"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <Border x:Name="Splash" Grid.ColumnSpan="3" Background="#0A0B0C">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/synapse.ico" Width="64" Height="64"/>
                <TextBlock x:Name="SplashText" Text="Starting Synapse…" Foreground="#8E8E96" FontSize="13" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                <Button x:Name="SplashButton" Style="{StaticResource PillButton}" Margin="0,16,0,0" Visibility="Collapsed" HorizontalAlignment="Center" Click="SplashButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
